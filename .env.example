# Akaun Simple AI Connector – API configuration
# Copy to .env (development) or /etc/akaun-simple-ai/api.env (production, chmod 600).
# NEVER commit real keys. NEVER put provider keys in the add-in (apps/excel-addin).

NODE_ENV=production
# Bind to localhost only – Nginx terminates HTTPS and proxies /api/
HOST=127.0.0.1
PORT=8787
# Number of reverse proxies in front of Node (Nginx = 1)
TRUST_PROXY=1

# Comma-separated explicit origins allowed to call the API
CORS_ALLOWED_ORIGINS=https://ai.akaunsimple.my

# ---- Pilot access control -------------------------------------------------------
# Comma-separated label:sha256hex entries. Generate each with: npm run keygen -- <label>
PILOT_ACCESS_KEYS=
DAILY_QUOTA_PER_KEY=30
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
REQUEST_BODY_LIMIT=64kb

# ---- AI provider --------------------------------------------------------------------
# openai | anthropic | mock (mock is refused when NODE_ENV=production)
AI_PROVIDER=anthropic
AI_REQUEST_TIMEOUT_MS=90000
AI_MAX_OUTPUT_TOKENS=8000
AI_MAX_RETRIES=2
AI_INVALID_OUTPUT_RETRIES=1

OPENAI_API_KEY=
# Must be a model that supports Responses API structured outputs (json_schema, strict)
OPENAI_MODEL=gpt-5-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (beta). Set to false to disable.
ANTHROPIC_SERVER_FALLBACK=true

LOG_LEVEL=info
